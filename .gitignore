# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Env / secrets
.env
*.env
.env.*

# Local data (the SQLite DB + vector store live here — never commit)
data/
!data/
data/*
!data/demo/
!data/demo/demo-incident.json

# Runtime working directories: uploaded logs, uploaded archives, extracted
# trees. These are whatever a user handed the dashboard, which is exactly the
# category of file that should never be committed by accident - it is somebody
# else's data, and three of them reached a commit before this rule existed.
data/*/work/
work/
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store

# Models (Ollama stores its own; never vendor weights)
*.gguf

# Third-party tool binaries + rule sets (Hayabusa etc). Installed by script,
# never vendored — 66MB and platform-specific.
tools/

# Datasets live outside the repo entirely ($HOME/.ares/datasets),
# but belt-and-braces in case anyone extracts one in here.
*.evtx
datasets/
